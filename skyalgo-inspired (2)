            <div class="field"><label for="razorpayKey">Razorpay key ID</label><input id="razorpayKey" placeholder="rzp_test_xxxxxxxx"></div>
            <div class="field"><label for="apiUrl">Backend API base URL</label><input id="apiUrl" placeholder="https://your-domain.com/api"></div>
